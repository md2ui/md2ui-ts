{
  "name": "@md2ui/react",
  "version": "0.1.0-alpha.1",
  "description": "Thin React binding over <md2ui-view>.",
  "keywords": [
    "md2ui",
    "markdown",
    "react",
    "generative-ui",
    "agent"
  ],
  "homepage": "https://md2ui.org",
  "bugs": {
    "url": "https://github.com/md2ui/md2ui-ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md2ui/md2ui-ts.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/lib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "exports": {
      ".": {
        "types": "./dist/lib/index.d.ts",
        "default": "./dist/lib/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "@md2ui/dom": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19"
  }
}
