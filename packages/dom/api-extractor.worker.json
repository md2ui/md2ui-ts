{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": ".",
  "mainEntryPointFilePath": "<projectFolder>/dist/lib/worker.d.ts",
  "compiler": {
    "overrideTsconfig": {
      "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": [],
        "strict": true,
        "skipLibCheck": true
      },
      "include": ["dist/lib"]
    }
  },
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/dist/api/",
    "reportFileName": "dom-worker"
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "none"
      }
    }
  }
}
